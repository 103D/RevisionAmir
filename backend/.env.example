# Backend Environment Variables
# For local development (Vercel uses its own env vars)

APP_HOST=0.0.0.0
APP_PORT=8000

# Redis URL (optional for local, required for Vercel)
# Get it from Upstash Dashboard → Connect → Redis
# Format: rediss://default:password@host:6379
# Example: REDIS_URL=rediss://default:xxxx@abc123.upstash.io:6379
# If REDIS_URL is not set, backend uses JSON files (backend/data/*.json)
REDIS_URL=
