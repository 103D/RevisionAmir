# ============================================================
# Frontend Environment Variables
# ============================================================
# IMPORTANT: Vite requires variables to start with VITE_ to be exposed to the client

# API backend URL (required)
# In development: http://localhost:8000
# In production (separate deployment): your backend URL e.g. https://api.vercel.app
# In production (monorepo): leave empty to use relative path /api/v1
VITE_API_URL=http://localhost:8000

# Application title (optional)
VITE_APP_TITLE=Revision Management
