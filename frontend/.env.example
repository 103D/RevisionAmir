# ============================================================
# Frontend Environment Variables
# ============================================================
# IMPORTANT: Vite requires variables to start with VITE_ to be exposed to the client

# API backend URL — must include the /api/v1 path
# Examples:
#   Development: http://localhost:8000/api/v1
#   Production:  https://revision-backend.vercel.app/api/v1
VITE_API_URL=http://localhost:8000/api/v1

# Application title (optional)
VITE_APP_TITLE=Revision Management
