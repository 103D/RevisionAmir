# ============================================================
# SEPARATE DEPLOYMENT CONFIGURATION
# ============================================================
# Это конфигурация для раздельного деплоя backend и frontend на Vercel
# (каждый как отдельный проект Vercel)

# ============================================================
# Backend (.env в папке backend/)
# ============================================================
# Переменные для бэкенда (no special vars needed for Vercel)
# APP_HOST=0.0.0.0      # не требуется на Vercel
# APP_PORT=8000         # не требуется на Vercel
# STORE_PATH=./data/store.json  # не требуется на Vercel (in-memory)

# ============================================================
# Frontend (.env в папке frontend/)
# ============================================================
# VITE_API_URL — обязательная переменная для frontend когда backend деплоен отдельно
# Установите на Vercel Dashboard → Project Settings → Environment Variables
# Пример: VITE_API_URL=https://revision-backend.vercel.app
# (без /api/v1, т.к. baseURL в api.js добавляет его)
VITE_API_URL=http://localhost:8000

# Дополнительные опции:
# VITE_APP_TITLE=Revision Management

# ============================================================
# Development (локальный запуск)
# ============================================================
# Для локального запуска frontend использует VITE_API_URL=http://localhost:8000
# Для локального запуска backend читает .env из backend/.env (APP_PORT=8000)
