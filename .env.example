# ============================================================
# Local Development Configuration
# ============================================================
# These variables are used only for local development.
# On Vercel, the platform provides its own environment variables.

BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
BACKEND_RELOAD=true

FRONTEND_PORT=5173
# VITE_API_URL is used only in development. In production (Vercel),
# the frontend automatically uses relative path '/api/v1' to call the backend.
VITE_API_URL=http://localhost:8000

DATA_DIR=./backend/data
STORE_FILE=store.json

# ============================================================
# Vercel Deployment Notes
# ============================================================
# 1. No environment variables are required for basic deployment.
# 2. The backend and frontend are deployed as a single monorepo.
# 3. API endpoints are available at /api/v1/* on your Vercel domain.
# 4. Data is stored in-memory on Vercel (not persistent between invocations).
#    For production use, configure a database (PostgreSQL, Redis, etc.).
# 5. To set environment variables in Vercel, use the Vercel Dashboard or CLI:
#    vercel env add <environment-variable-name> <value> --platform <environment>
