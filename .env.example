# ============================================================
# SEPARATE DEPLOYMENT CONFIGURATION
# ============================================================
# Используется при раздельном деплое backend и frontend на Vercel
# (каждый как отдельный проект)

# ============================================================
# Backend (.env в папке backend/)
# ============================================================
# Для Vercel backend не требует обязательных переменных.
# Локально можно использовать:
# APP_HOST=0.0.0.0
# APP_PORT=8000
# STORE_PATH=./data/store.json

# ============================================================
# Frontend (.env в папке frontend/)
# ============================================================
# VITE_API_URL — обязательная переменная при раздельном деплое.
# Устанавливается в Vercel Dashboard (Project Settings → Environment Variables)
# Пример: VITE_API_URL=https://revision-backend.vercel.app/api/v1
# (обратите внимание на суффикс /api/v1)
VITE_API_URL=http://localhost:8000/api/v1

# Дополнительно:
# VITE_APP_TITLE=Revision Management

# ============================================================
# Локальный запуск
# ============================================================
# Frontend: VITE_API_URL=http://localhost:8000/api/v1
# Backend: из .env файла в backend/ (APP_PORT=8000)
