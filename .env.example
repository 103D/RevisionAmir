# ============================================================
# SEPARATE DEPLOYMENT CONFIGURATION
# ============================================================
# Используется при раздельном деплое backend и frontend на Vercel

# ============================================================
# Backend (.env в папке backend/)
# ============================================================
# Для продакшена (Vercel) требуется Redis (Upstash).
# Локально данные сохраняются в JSON-файлы.

# Redis URL (обязательно для Vercel):
# - Upstash Redis: UPSTASH_REDIS_REST_URL + UPSTASH_REDIS_REST_TOKEN
# - Или единый URL: REDIS_URL=redis://...
# Пример (Upstash): REDIS_URL=rediss://default:xxx@...upstash.io:6379
# REDIS_URL=

# Локальные переменные (не требуются на Vercel):
# APP_HOST=0.0.0.0
# APP_PORT=8000

# ============================================================
# Frontend (.env в папке frontend/)
# ============================================================
# VITE_API_URL — обязательная при раздельном деплое.
# Пример: https://revision-backend.vercel.app/api/v1
VITE_API_URL=http://localhost:8000/api/v1

# Дополнительно:
# VITE_APP_TITLE=Revision Management

# ============================================================
# Локальный запуск
# ============================================================
# Backend: backend/.env (APP_PORT=8000, REDIS_URL не требуется)
# Frontend: frontend/.env (VITE_API_URL=http://localhost:8000/api/v1)
