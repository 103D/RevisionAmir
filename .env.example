# ============================================================
# SEPARATE DEPLOYMENT CONFIGURATION
# ============================================================

# ============================================================
# Backend (.env in backend/ folder)
# ============================================================
# REDIS_URL — для Vercel (обязательно) и локально (опционально)
# Получите на Upstash: Dashboard → Connect → Redis
# Пример: REDIS_URL=rediss://default:password@abc123.upstash.io:6379
# REDIS_URL=

# Локальные переменные (не требуются на Vercel):
# APP_HOST=0.0.0.0
# APP_PORT=8000

# ============================================================
# Frontend (.env in frontend/ folder)
# ============================================================
# VITE_API_URL — обязательная при раздельном деплое.
# Пример: https://revision-backend.vercel.app/api/v1
VITE_API_URL=http://localhost:8000/api/v1

# Дополнительно:
# VITE_APP_TITLE=Revision Management

# ============================================================
# Local development
# ============================================================
# Backend: use backend/.env (APP_PORT=8000, REDIS_URL optional)
# Frontend: use frontend/.env (VITE_API_URL=http://localhost:8000/api/v1)
